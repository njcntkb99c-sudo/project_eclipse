*{box-sizing:border-box}body{margin:0;padding:12px;background:#07090d;color:#edf4ff;font-family:system-ui}main{max-width:1180px;margin:auto}header{display:flex;gap:18px;align-items:center;padding:12px;background:#0e131c;border:1px solid #30394b}header span{color:#91a0b4}section{position:relative;border:1px solid #30394b}canvas{display:block;width:100%;image-rendering:pixelated;touch-action:none}.overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:#030509cc}.show{display:flex}.panel{width:min(500px,92%);padding:24px;text-align:center;background:#111722;border:1px solid #3b4659;border-radius:18px}.panel h1{font:44px Georgia}.panel label{display:block;text-align:left;margin:14px 0}.panel select,.panel button{width:100%;padding:12px;margin-top:8px;border-radius:10px;border:1px solid #3a4558;background:#0b1018;color:white}.panel button{background:#69adff;color:#07101b;font-weight:800}.info{padding:12px;background:#21182b;border-radius:10px}.mobile{display:none;position:absolute;left:8px;right:8px;bottom:8px;gap:6px;justify-content:space-between}.mobile button{min-height:46px;background:#111a27dd;color:white;border:1px solid #40506a;border-radius:10px}#notice{position:absolute;top:15%;left:50%;transform:translateX(-50%);background:#080c13ee;padding:10px 16px;border-radius:25px;opacity:0}#notice.on{opacity:1}@media(max-width:800px){body{padding:0}.mobile{display:flex}header{font-size:12px;flex-wrap:wrap}.panel h1{font-size:34px}}